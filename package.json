{
  "name": "cloudflare-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "build:workers": "tsc -p scripts/tsconfig.json",
    "start:oracle": "node -r dotenv/config dist/scripts/candleEngine.js",
    "dev:oracle": "ts-node -r dotenv/config scripts/candleEngine.ts",
    "lint:eslint": "next lint",
    "lint:prettier": "prettier . --check",
    "format": "prettier . --write",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@daohaus/abis": "^0.5.5",
    "@daohaus/contract-utils": "^0.5.5",
    "@google/genai": "^2.4.0",
    "@metamask/jazzicon": "github:metamask/jazzicon",
    "@namestone/namestone-sdk": "^0.2.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.1",
    "axios": "^1.10.0",
    "dotenv": "^17.2.1",
    "ether": "^0.0.9",
    "ethers": "^6.15.0",
    "framer-motion": "^12.6.3",
    "gsap": "^3.12.7",
    "jwt-decode": "^4.0.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.487.0",
    "next": "15.2.9",
    "nodemailer": "^7.0.5",
    "postgres": "^3.4.7",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "supabase": "^2.39.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250321.0",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.16.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.25.1",
    "eslint-config-next": "15.2.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.4.0"
  }
}
